{
  "name": "hello-pear-react-native",
  "version": "1.0.0",
  "upgrade": "pear://6icyde363aziow3ouwerwo1meh9cy8r41m83zzr4fo4aux4iaudy",
  "main": "index.ts",
  "scripts": {
    "pack": "npx bare-pack --host ios --host android --linked --out ./src/worker.bundle.js ./pearend/worker.js",
    "update": "npx react-native bundle --platform ios --dev false --entry-file index.ts --bundle-output dist/runtime.ios.bundle --assets-dest dist/assets && npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output dist/runtime.android.bundle --assets-dest dist/assets && cp -f package.json dist/package.json",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "production:ios": "npx expo run:ios --configuration Release",
    "production:android": "npx expo run:android --configuration Release"
  },
  "repository": {
    "type": "git",
