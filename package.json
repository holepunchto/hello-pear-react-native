  },
  "homepage": "https://github.com/holepunchto/hello-pear-react-native",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "b4a": "^1.7.3",
    "bare-fs": "^4.5.3",
    "bare-path": "^3.0.0",
    "bare-rpc": "^1.1.0",
    "expo": "~54.0.33",
    "expo-build-properties": "^1.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
